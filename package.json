{
  "name": "squanchy-fridge-monitor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently --kill-others --names api,web \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "db:generate": "npm run db:generate --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:prepare": "npm run db:prepare --workspace backend",
    "db:deploy": "npm run db:deploy --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "db:analyze": "npm run db:analyze --workspace backend",
    "db:studio": "npm run db:studio --workspace backend"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
