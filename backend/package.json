{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:prepare": "tsx prisma/prepare.ts",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:analyze": "tsx prisma/analyze.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
